# Copy to .env. Placeholder values are safe for local development only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_local_password
ERP_READER_USER=erp_reader
ERP_READER_PASSWORD=erp_reader_local_password
# Raw layer root: a local path, or s3://bucket/raw with the S3_* variables below.
RAW_URI=data/raw
# Overlap subtracted from the extract watermark, in seconds.
EXTRACT_LOOKBACK_SECONDS=300
# Object storage credentials; leave unset for local paths. An unset endpoint targets AWS S3.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# DuckDB file written by dbt.
WAREHOUSE_PATH=data/warehouse.duckdb
# dbt target: local (stage 3); r2 and snowflake arrive in later stages.
DBT_TARGET=local
